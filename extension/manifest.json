{
  "manifest_version": 3,
  "name": "NimBros — Trade from X",
  "version": "1.0.0",
  "description": "See a coin mentioned on X? Trade it on NimBros in two clicks. Never signs anything itself — it only opens NimBros with the coin pre-filled.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://x-nimbros-si.pages.dev/*"],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
