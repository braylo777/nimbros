# Copy to .env.local for local work. In production these are Cloudflare Pages secrets/vars:
#   wrangler pages secret put <NAME>
# Never commit real values.

# Solana RPC endpoint (Helius/Triton/QuickNode). The key lives in the URL, so treat the whole URL as a secret.
SOLANA_RPC_URL=https://<your-rpc-provider>/?api-key=<YOUR_RPC_KEY>
# Raises Jupiter rate limits (optional)
JUPITER_API_KEY=<YOUR_JUPITER_KEY>
JUPITER_API_URL=https://lite-api.jup.ag
# Solana wallet that receives the platform fee. Fee stays 0 bps until this is set.
TREASURY_ADDRESS=<YOUR_TREASURY_WALLET_ADDRESS>
# Shared secret for /api/cron/* endpoints
CRON_SECRET=<RANDOM_32_BYTE_HEX>
# Real agent trading: off by default. Allowlist is a JSON list or comma list of approved addresses.
REAL_AGENT_TRADING=0
AGENT_ALLOWLIST=
PLATFORM_FEE_BPS=15
# MoonPay on-ramp (optional)
MOONPAY_PUBLIC_KEY=<YOUR_MOONPAY_PUBLIC_KEY>
MOONPAY_SECRET_KEY=<YOUR_MOONPAY_SECRET_KEY>
NEXT_PUBLIC_MOONPAY_ENABLED=0
# Screenshot service (optional)
MICROLINK_KEY=<YOUR_MICROLINK_KEY>
# Public site URL used in links
SITE=https://<your-site>
# GoPlus EVM wallet safety check (optional)
GOPLUS_APP_KEY=<YOUR_GOPLUS_APP_KEY>
GOPLUS_APP_SECRET=<YOUR_GOPLUS_APP_SECRET>
